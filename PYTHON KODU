def process_command(page, context, command):

    command = normalize_text(command)


    if not command:

        return page, True


    # =====================================================
    # KAPAT
    # =====================================================

    if command in [
        "kapat",
        "programı kapat",
        "programi kapat",
        "çık",
        "cik"
    ]:

        print(
            "\n🛑 Program kapatılıyor..."
        )

        return page, False


    # =====================================================
    # EKRAN GÖRÜNTÜSÜ
    # =====================================================

    if (
        "ekran görüntüsü" in command
        or "ekran goruntusu" in command
        or "ekran görüntüsü al" in command
        or "ekran goruntusu al" in command
    ):

        take_screenshot(page)

        return page, True


    # =====================================================
    # EN ALT
    # =====================================================

    if (
