# =========================================================
# OCR İÇİN GÖRÜNTÜ HAZIRLA
# =========================================================

def prepare_image(image):

    # Görüntüyü 2 kat büyüt
    image = image.resize(
        (
            image.width * 2,
            image.height * 2
        )
    )

    # Gri ton
    image = image.convert("L")

    # Kontrast artır
    image = ImageEnhance.Contrast(image).enhance(1.5)

    # Keskinlik artır
    image = ImageEnhance.Sharpness(image).enhance(1.5)

    # Hafif filtre
    image = image.filter(
        ImageFilter.SHARPEN
    )

    return image


# =========================================================
# OCR EKRAN TARAMA
# =========================================================

def ocr_screen(page):

    if not OCR_AVAILABLE:

        return []


    if not TESSERACT_PATH:

        return []


    try:

        screenshot_bytes = page.screenshot(
            full_page=False
        )

        image = Image.open(
            io.BytesIO(screenshot_bytes)
        )

        original_width = image.width
        original_height = image.height

        image = prepare_image(image)

        data = pytesseract.image_to_data(
            image,
            lang="tur+eng",
            config="--oem 3 --psm 11",
            output_type=pytesseract.Output.DICT
        )

        results = []

        count = len(data["text"])

        for i in range(count):

            text = data["text"][i].strip()

            if not text:
                continue


            try:

                confidence = float(
                    data["conf"][i]
                )

            except:

                confidence = 0


            if confidence < 25:

                continue


            x = int(data["left"][i])
            y = int(data["top"][i])
            width = int(data["width"][i])
            height = int(data["height"][i])


            # Görüntüyü 2 kat büyüttüğümüz için
            # koordinatları tekrar orijinale indiriyoruz.

            x = int(x / 2)
            y = int(y / 2)
            width = int(width / 2)
            height = int(height / 2)


            results.append({

                "text": text,

                "x": x,
                "y": y,

                "width": width,
                "height": height,

                "confidence": confidence,

            })


        return results


    except Exception as e:

        print(f"❌ OCR hatası: {e}")

        return []


# =========================================================
# EKRANDA METİN BUL
# =========================================================

def find_text_on_screen(page, target):

    target = normalize_text(target)

    target_no_tr = remove_turkish_chars(target)


    if len(target) < 2:

        print("⚠️ OCR için hedef çok kısa.")

        return None


    print(f"🔎 Ekranda '{target}' aranıyor...")


    ocr_results = ocr_screen(page)


    if not ocr_results:

        print("❌ OCR herhangi bir metin bulamadı.")

        return None


    # =====================================================
    # 1. TAM HEDEF
    # =====================================================

    for item in ocr_results:

        word = normalize_text(
            item["text"]
        )

        word_no_tr = remove_turkish_chars(word)


        if (
            word == target
            or word_no_tr == target_no_tr
        ):

            print(
                f"✅ Tam hedef bulundu: '{item['text']}'"
            )

            return item


    # =====================================================
    # 2. TEK KELİME İÇİN TAM KELİME ARAMA
    # =====================================================

    for item in ocr_results:

        word = normalize_text(
            item["text"]
        )

        word_no_tr = remove_turkish_chars(word)


        if (
            contains_word(word, target)
            or contains_word(word_no_tr, target_no_tr)
        ):

            print(
                f"✅ Hedef bulundu: '{item['text']}'"
            )

            return item


    # =====================================================
    # 3. ÇOK KELİMELİ HEDEF
    # =====================================================

    target_words = target.split()


    if len(target_words) > 1:

        for i in range(len(ocr_results)):

            combined = ""

            first = None
            last = None


            for j in range(
                i,
                min(
                    i + len(target_words) + 2,
                    len(ocr_results)
                )
            ):

                current = normalize_text(
                    ocr_results[j]["text"]
                )

                if not current:
                    continue


                if first is None:

                    first = ocr_results[j]


                last = ocr_results[j]

                combined += " " + current

                combined = combined.strip()


                combined_no_tr = remove_turkish_chars(
                    combined
                )


                if (
                    target in combined
                    or target_no_tr in combined_no_tr
                ):

                    x1 = first["x"]
                    y1 = first["y"]

                    x2 = (
                        last["x"]
                        + last["width"]
                    )

                    y2 = (
                        last["y"]
                        + last["height"]
                    )


                    result = {

                        "text": combined,

                        "x": x1,

                        "y": y1,

                        "width": x2 - x1,

                        "height": y2 - y1,

                    }


                    print(
                        f"✅ Çok kelimeli hedef bulundu: '{combined}'"
                    )

                    return result


    print(
        f"❌ Ekranda '{target}' bulunamadı."
    )

    return None


