# =========================================================
# METİN NORMALLEŞTİRME
# =========================================================

def normalize_text(text):

    if not text:
        return ""

    text = text.lower()

    text = text.replace("’", "'")
    text = text.replace("`", "'")

    text = re.sub(r"\s+", " ", text)

    return text.strip()


# =========================================================
# TÜRKÇE KARAKTERLERİ NORMALLEŞTİR
# =========================================================

def remove_turkish_chars(text):

    replacements = {

        "ç": "c",
        "ğ": "g",
        "ı": "i",
        "ö": "o",
        "ş": "s",
        "ü": "u",

    }

    for old, new in replacements.items():

        text = text.replace(old, new)

    return text


# =========================================================
# KELİME KONTROLÜ
# =========================================================

def contains_word(text, target):

    text = normalize_text(text)
    target = normalize_text(target)

    if len(target) < 2:

        return False

    pattern = r"(?<!\w)" + re.escape(target) + r"(?!\w)"

    return re.search(pattern, text) is not None


