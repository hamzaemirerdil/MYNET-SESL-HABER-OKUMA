def start_chrome(playwright):

    print(
        "🌐 Google Chrome başlatılıyor..."
    )


    try:

        context = playwright.chromium.launch_persistent_context(

            user_data_dir=CHROME_PROFILE,

            channel="chrome",

            headless=False,

            viewport={
                "width": 1280,
                "height": 800
            },

        )


        return context


    except Exception as e:

        print("\n❌ Chrome başlatılamadı.")

        print(e)

        print(
            "\n⚠️ Chrome'un bütün pencerelerini kapatıp"
        )

        print(
            "programı tekrar çalıştır."
        )

        return None


