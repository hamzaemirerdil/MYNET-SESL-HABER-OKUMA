def clean_target(target):

    target = normalize_text(target)


    # Apostrofları kaldır
    target = target.replace(
        "'",
        ""
    )


    aliases = {

        "habere": "haber",

        "haberine": "haber",

        "haberleri": "haber",

        "haberler": "haber",

        "spora": "spor",

        "spora": "spor",

        "spor'a": "spor",

        "finansa": "finans",

        "finans'a": "finans",

        "sağlığa": "sağlık",

        "sagliga": "sağlık",

        "gümüşe": "gümüş",

        "gumuse": "gümüş",

        "faize": "faiz",

        "altına": "altın",

        "altina": "altın",

        "dolara": "dolar",

        "euroya": "euro",

        "teknolojiye": "teknoloji",

        "fenerbahçeye": "fenerbahçe",

        "fenerbahceye": "fenerbahçe",

        "galatasaraya": "galatasaray",

        "beşiktaşa": "beşiktaş",

        "besiktasa": "beşiktaş",

        "resmi ilanlara": "resmi ilanlar",

        "resmi ilanına": "resmi ilanlar",

        "resmi ilanlari": "resmi ilanlar",

        "resmi ilanlar": "resmi ilanlar",

    }


    if target in aliases:

        return aliases[target]


    return target


# =========================================================
# TIKLAMA HEDEFİNİ ÇIKAR
# =========================================================

def extract_click_target(command):

    text = normalize_text(command)


    # =====================================================
    # TIKLA KELİMESİNİ KALDIR
    # =====================================================

    text = re.sub(
        r"\b(tıkla|tikla)\b",
        " ",
        text
    )


    # =====================================================
    # KOMUT SONLARINI KALDIR
    # =====================================================

    text = re.sub(
        r"\b(üzerine|uzerine|butonuna|butonunu|aç|ac|git|gir)\b",
        " ",
        text
    )


    # =====================================================
    # KOMUT BAŞLARINI KALDIR
    # =====================================================

    text = re.sub(
        r"^(şuna|suna|buraya|oraya|lütfen|hemen)\s+",
        "",
        text
    )


    text = re.sub(
        r"\s+",
        " ",
        text
    ).strip()


    return clean_target(text)


