def click_dom_text(page, target):

    print(
        f"🌐 DOM içinde '{target}' aranıyor..."
    )


    try:

        locator = page.get_by_text(
            target,
            exact=False
        ).first


        locator.wait_for(
            state="visible",
            timeout=3000
        )


        locator.scroll_into_view_if_needed()

        page.wait_for_timeout(300)


        box = locator.bounding_box()


        if box:

            center_x = (
                box["x"]
                + box["width"] / 2
            )

            center_y = (
                box["y"]
                + box["height"] / 2
            )


            print(
                f"📍 DOM koordinatı: "
                f"X={int(center_x)} "
                f"Y={int(center_y)}"
            )


            page.mouse.click(
                center_x,
                center_y
            )

        else:

            locator.click(
                timeout=3000
            )


        print(
            f"✅ '{target}' tıklandı."
        )


        page.wait_for_timeout(1000)

        return True


    except Exception as e:

        print(
            f"❌ DOM tıklama başarısız: {e}"
        )

        return False


# =========================================================
# AKILLI TIKLAMA
# OCR + DOM + YENİ SEKME KONTROLÜ
# =========================================================

def smart_click(page, context, target):

    print("\n" + "=" * 60)

    print("🤖 AKILLI TIKLAMA")

    print("=" * 60)


    # =====================================================
    # TIKLAMADAN ÖNCEKİ SEKME LİSTESİ
    # =====================================================

    old_pages = context.pages.copy()


    # =====================================================
    # 1. OCR
    # =====================================================

    clicked = click_ocr_target(
        page,
        target
    )


    # =====================================================
    # 2. DOM FALLBACK
    # =====================================================

    if not clicked:

        print(
            "\n⚠️ OCR hedefi bulamadı."
        )

        print(
            "🌐 DOM yöntemi deneniyor..."
        )


        clicked = click_dom_text(
            page,
            target
        )


    # =====================================================
    # HİÇBİR ŞEY BULUNAMADI
    # =====================================================

    if not clicked:

        print(
            f"❌ '{target}' bulunamadı."
        )

        return page


    # =====================================================
    # YENİ SEKME BEKLE
    # =====================================================

    print(
        "\n🔎 Yeni sekme kontrol ediliyor..."
    )


    for _ in range(30):

        current_pages = context.pages


        if len(current_pages) > len(old_pages):

            break


        page.wait_for_timeout(100)


    # =====================================================
    # YENİ SEKME AÇILDI MI?
    # =====================================================

    current_pages = context.pages


    if len(current_pages) > len(old_pages):

        new_pages = [

            p
            for p in current_pages
            if p not in old_pages

        ]


        if new_pages:

            new_page = new_pages[-1]


            try:

                new_page.wait_for_load_state(
                    "domcontentloaded",
                    timeout=5000
                )

            except:

                pass


            page = new_page


            try:

                page.bring_to_front()

            except:

                pass


            page.wait_for_timeout(1000)


            print(
                "🆕 Yeni sekme açıldı."
            )

            print(
                f"📑 Aktif sekme sayısı: "
                f"{len(context.pages)}"
            )


            try:

                print(
                    f"🌐 Yeni sayfa: "
                    f"{page.url}"
                )

            except:

                pass


    else:

        print(
            "📄 Yeni sekme açılmadı."
        )

        print(
            "📌 Mevcut sekmede devam ediliyor."
        )


    return page


